module ScalarType

  use import algebra.Ring

  type t

  constant zero : t
  val function add (x y: t) : t
  val function sub (x y: t) : t
  val function mul (x y: t) : t

  clone export algebra.Ring with
    type t = t,
    constant zero = zero,
    function (+)  = add,
    function (*)  = mul

  
  val function div (x y: t) : t
  val function eq (x y: t) : bool
  val function lt (x y: t) : bool
  val function le (x y: t) : bool
  val function gt (x y: t) : bool
  val function ge (x y: t) : bool

end

