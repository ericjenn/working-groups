module ScalarFloat32
  

  use ieee_float.Float32 as Float32
  use import scalar.ScalarType

   let constant zero_float32 : Float32.t = Float32.zeroF
  
  let  add_float32 (x y: Float32.t) : Float32.t = Float32.(.+) x y
  let  sub_float32  (x y: Float32.t) : Float32.t = Float32.(.-) x y
  let  mul_float32  (x y: Float32.t) : Float32.t = Float32.(.* ) x y
  let  div_float32  (x y: Float32.t) : Float32.t = Float32.(./) x y


  let  eq_float32  (x y: Float32.t) : bool = Float32.(.=) x y
  let  lt_float32  (x y: Float32.t) : bool = Float32.(.<) x y
  let  le_float32  (x y: Float32.t) : bool = Float32.(.<=) x y
  let  gt_float32  (x y: Float32.t) : bool = Float32.(.>) x y
  let  ge_float32  (x y: Float32.t) : bool = Float32.(.>=) x y


  (* Clone of the abstract ScalarType and fill in with the concrete/defined functions *)
  clone export scalar.ScalarType with
    type t = Float32.t,
    constant zero = zero_float32,
    val add = add_float32,
    val sub = sub_float32,
    val mul = mul_float32,
    val div = div_float32,
    val eq  = eq_float32,
    val lt  = lt_float32,
    val le  = le_float32,
    val gt  = gt_float32,
    val ge  = ge_float32

  type scalar_f32 = Float32.t

end

module OpAdd_Float32

  use import ScalarFloat32 as F32
  clone opadd.Add with 
  type t = F32.scalar_f32,
  constant zero = F32.zero_float32,
  val  add = F32.add_float32  
end