(**
    Scalar Definition.
 *)

module Scalar
  use int.Int as Int

  use import mach.int.Byte as UInt8
  use import mach.int.Int32 as Int32
  use import mach.int.UInt32 as UInt32
  use import mach.int.Int16 as Int16
  use import mach.int.UInt16 as UInt16
  use import mach.int.Int64 as Int64
  use import mach.int.UInt64 as UInt64
  use import ieee_float.Float32 as Float32
  use import ieee_float.Float64 as Float64

  type scalar =
    | IsUInt8 byte 
    | IsInt16 int16
    | IsUInt16 uint16
    | IsInt32 int32
    | IsUInt32 uint32
    | IsInt64 int64
    | IsUInt64 uint64
    | IsFloat32 Float32.t
    | IsFloat64 Float64.t


  let function tag (s: scalar) : int =
    match s with
    | IsUInt8   _ -> 0
    | IsInt16   _ -> 1
    | IsUInt16  _ -> 2
    | IsInt32   _ -> 3
    | IsUInt32  _ -> 4
    | IsInt64   _ -> 5
    | IsUInt64  _ -> 6
    | IsFloat32 _ -> 7
    | IsFloat64 _ -> 8
    end 

  let add (s1: scalar) (s2: scalar) : scalar
   requires { tag s1 = tag s2 }
  =
    match s1, s2 with
    | IsUInt8 v1, IsUInt8 v2 ->
      IsUInt8 (UInt8.(+) v1 v2) 
      
    | IsInt16 v1, IsInt16 v2 ->
      IsInt16 (Int16.(+) v1 v2)
      
    | IsUInt16 v1, IsUInt16 v2 ->
      IsUInt16 (UInt16.(+) v1 v2)
      
    | IsInt32 v1, IsInt32 v2 ->
      IsInt32 (Int32.(+) v1 v2)
      
    | IsUInt32 v1, IsUInt32 v2 ->
      IsUInt32 (UInt32.(+) v1 v2)

    | IsFloat32 v1, IsFloat32 v2 ->
        IsFloat32 (Float32.(.+) v1 v2)
    
    | IsFloat64 v1, IsFloat64 v2 ->
        IsFloat64 (Float64.(.+)  v1 v2)
      
    | IsInt64 v1, IsInt64 v2 ->
      IsInt64 (Int64.(+) v1 v2)
      
    | IsUInt64 v1, IsUInt64 v2 ->
      IsUInt64 (UInt64.(+) v1 v2)

    |_,_ -> absurd 
    
    end
end

