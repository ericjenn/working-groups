(**
    Specification of Add operation on tensors.
 *)

module Add

  use int.Int
  use map.Map
  use scalar.Scalar
  use tensor.Shape
  use tensor.Tensor
  use sequence.Seq
  

  
(* val eq_shape (s1: shape) (s2: shape) : bool
  ensures { result <-> s1 = s2 }*)


let add_tensors (a: tensor scalar) (b: tensor scalar) : tensor scalar
    (* Trivial case: Broadcasting is ignored, shapes must be identical. *)
    (* requires { eq_shape a.shape b.shape } *)
  =
    let result_shape = a.shape in
    {
    
       shape = result_shape;
       value = fun (i: index) ->
          let idx_a = i in
          let idx_b = i in
          let val_a = a.value(idx_a) in
          let val_b = b.value(idx_b) in
          (* This call might raise Mismatched_Types *)
          Scalar.add val_a val_b
    }
end